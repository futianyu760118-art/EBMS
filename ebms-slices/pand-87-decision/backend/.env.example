# EBMS 后端本地运行配置（复制为 .env 后按需调整；不要提交真实密钥）
PORT=4600
NODE_ENV=development

# 数据库：pg（默认，架构方案选型）| sqlite（本地无 PG 实例时自检用）
DB_DRIVER=sqlite
SQLITE_FILE=./data/ebms.sqlite
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=ebms
PGPASSWORD=
PGDATABASE=ebms

# 登录 token（自签 HMAC-SHA256）—— 仅本地开发用，生产走企业身份源
EBMS_JWT_SECRET=dev-only-secret-do-not-use-in-production
EBMS_TOKEN_TTL=28800

# 分页默认值
EBMS_DEFAULT_LIMIT=20
EBMS_MAX_LIMIT=100

# 演示数据口令
EBMS_SEED_PASSWORD=ebms@2026
