{
  "name": "ebms-backend",
  "version": "0.1.0",
  "private": true,
  "description": "EBMS 企业经营管理系统 · 后端（模块化单体：router → service → repository）",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:sqlite": "node --experimental-sqlite src/server.js",
    "migrate": "node src/db/migrate.js",
    "migrate:sqlite": "node --experimental-sqlite src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "seed:sqlite": "node --experimental-sqlite src/db/seed.js",
    "test": "node --experimental-sqlite --test \"test/**/*.test.js\"",
    "smoke": "node --experimental-sqlite test/smoke-server.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1"
  }
}
