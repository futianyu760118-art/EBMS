# EBMS 同步/读侧切流配置示例（PAND-307 / PAND-309 R4）
# 用法：cp docker-compose.cutover.env.example .env 后填入真实凭据；凭据只放 .env，不提交仓库。
#
# 切流语义：CRM 为 6 模块唯一业务写侧；EBMS 负责
#   1) 入站：接收 CRM 的 AEOS.Event.V1（customer/inquiry/quote_library/order/sample/feedback）
#   2) 出站：admin 应急写入产生的变更仍回流 CRM（自动调度，每 5 分钟）

EBMS_APP_KEY=
EBMS_APP_SECRET=
EBMS_EXTERNAL_API_KEY=

# ---- AEOS 入站（CRM → EBMS）----
# 与 CRM 侧 EBMS_INGEST_TOKEN 一致，生产必须强随机
EBMS_INGEST_TOKEN=__REPLACE_WITH_EBMS_INGEST_TOKEN__

# ---- AEOS 出站（EBMS → CRM）----
# 与 CRM 侧 EBMS_INBOUND_TOKEN 一致，生产必须强随机
EBMS_INBOUND_TOKEN=__REPLACE_WITH_EBMS_INBOUND_TOKEN__
EBMS_CRM_INGEST_URL=http://host.docker.internal:8000/api/v1/integrations/ebms/ingest

# 出站自动调度（PAND-309 R3）：1=启用；间隔毫秒（默认 300000=5 分钟）
EBMS_AEOS_AUTOSYNC=1
EBMS_AEOS_FLUSH_INTERVAL_MS=300000

# 核价→报价库自动同步（PAND-309 R3）：切流后默认 0（停用），仅回滚演练置 1
EBMS_QUOTE_AUTOSYNC=0
