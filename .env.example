# ===== 外部对接密钥（必填）=====
# 复制本文件为 .env（或直接在部署环境/系统环境变量中设置），填入真实值。
# 缺失时：server.js 启动会打印告警，对应外部接口请求会被拒绝（fail-closed）。
# 注意：真实密钥严禁提交到代码仓库；.env 已在 .gitignore 中忽略。

# 外部数据供给/ERP 接口的 App Key（标识，随请求头 X-App-Key 发送，非机密）
EBMS_APP_KEY=

# 外部数据供给/ERP 接口的 HMAC-SHA256 签名密钥（机密；原硬编码值已泄露并轮换，
# 需与上游数据供给方 192.168.0.127:18084 同步为新值）
EBMS_APP_SECRET=

# 本系统对外接口 /api/external 的入站 API Key（X-API-Key，机密）
EBMS_EXTERNAL_API_KEY=

# ===== EBMS 对外只读接口 v1（/api/v1/external，对齐恒聘通/会议中心/M06-SPC 的 external 规范）=====
# 鉴权：X-App-Key + X-Timestamp + X-Signature（HMAC-SHA256(secret, "{timestamp}.{method}.{path}")）。
# AppKey 随请求头 X-App-Key 发送（标识，非机密）；AppSecret 为签名密钥（机密）。
# 未配置时端点 fail-closed 返回 503。
EBMS_EXTERNAL_APP_KEY=
EBMS_EXTERNAL_APP_SECRET=

# ===== AEOS 销售数据同步通道（EBMS ↔ CRM/M05，契约见 contracts/aeos-contracts-v1.schema.json）=====
# 四个变量均为按需启用：未配置时通道 fail-closed —— 入站端点返回 503 且不写业务表，
# 出站事件一律留在本地 Outbox（不丢事件），不产生任何对外投递。

# 入站：CRM 回写事件推送到 EBMS /api/aeos/ingest 时必须携带的 Bearer 令牌（机密）。
# 这是 EBMS 自己签发的令牌（开发B 侧持有），与下面 CRM 侧的令牌不是同一个值。
EBMS_INGEST_TOKEN=

# 出站：向 CRM /api/v1/integrations/ebms/ingest 投递时携带的 Bearer 令牌（机密）。
# 与 CRM 侧同名同值 —— 契约 §5.2 冻结 CRM 入站校验的就是 EBMS_INBOUND_TOKEN，
# EBMS 出站携带同一个值；两端部署时填入同一串随机值。
EBMS_INBOUND_TOKEN=

# 出站：CRM 入站端点地址。留空则出站不投递，事件只堆在 Outbox 等人工处理。
EBMS_CRM_INGEST_URL=

# 出站：本地 spool 目录（transport=spool 时用于落盘投递）。留空则用 backend/data/aeos-outbox-spool。
EBMS_AEOS_SPOOL_DIR=

# ===== M10 POMS 微系统对接（EBMS/M03 ↔ M10 执行面，契约见 contracts/m10-poms-v1.schema.json）=====
# 机器通道：M10 BFF 调 /api/m10/partner/* 时必须携带的 Bearer 令牌（机密）。
# 未配置时机器通道 fail-closed 返回 503；EBMS 个人工作台（/api/m10/me/*）不受影响。
M10_PARTNER_TOKEN=

# M10 微系统门户地址（非机密），用于 EBMS「微系统」页面跳转；留空则只显示 EBMS 内工作台。
M10_PORTAL_URL=

# ===== AEOS 人员生命周期同步（Phase 1 统一契约，契约见 contracts/aeos-v1/person-lifecycle-*.schema.json）=====
# 端点：POST /internal/aeos/person-lifecycle（M02 EDP 分发 → EBMS adapter）。
# 鉴权：X-AEOS-Timestamp + X-AEOS-Signature（HMAC-SHA256(secret, "{timestamp}.{body}")）。
# 未配置时端点 fail-closed 返回 503，不读不写业务表。
AEOS_PERSON_LIFECYCLE_SECRET=

# ===== M02 EDP 对接（数据入库 + 数据服务取数）=====
# 数据入库（E 通道源记录推送）：POST /api/v1/ingest/records，用 ingest:write 的 SERVICE Key。
EDP_BASE_URL=
EDP_PUSH_KEY=

# 数据服务取数（data-api）：GET/POST /api/v1/data-api/{code}，用 data:read 的 Key（绑定消费方）。
# 各数据集 code 可用环境变量覆盖（默认 finance_result/sales_result/...）。
EDP_READ_KEY=
# EDP_DATASET_FINANCE=
# EDP_DATASET_INDICATORS=
# EDP_DATASET_EXCEPTIONS=
# EDP_DATASET_DECISIONS=
# EDP_DATASET_ACTIONS=

# ===== M05 CRM 销售看板取数（external API，契约见 IMA「AEOS云服务」/ M05 external）=====
# 鉴权：X-App-Key + X-Timestamp + X-Signature，signature=HMAC-SHA256(AppSecret, "{timestamp}.GET.{path}")。
# 未配置时 /api/sop/dept/sales-board 返回取数失败提示（不影响其他模块）。
CRM_EXTERNAL_HOST=http://150.158.13.110:3001
CRM_EXTERNAL_APP_KEY=
CRM_EXTERNAL_APP_SECRET=

# ===== M04 PLM 研发项目取数（需账号登录拿 JWT）=====
# 端点：POST /api/auth/login → GET /api/v1/projects。未配置账号时 /api/sop/dept/rd-board 返回「未接入」。
PLM_API_HOST=http://150.158.13.110:8081
PLM_USERNAME=
PLM_PASSWORD=
