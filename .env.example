# ===== 外部对接密钥（必填）=====
# 复制本文件为 .env（或直接在部署环境/系统环境变量中设置），填入真实值。
# 缺失时：server.js 启动会打印告警，对应外部接口请求会被拒绝（fail-closed）。
# 注意：真实密钥严禁提交到代码仓库；.env 已在 .gitignore 中忽略。

# 外部数据供给/ERP 接口的 App Key（标识，随请求头 X-App-Key 发送，非机密）
EBMS_APP_KEY=

# 外部数据供给/ERP 接口的 HMAC-SHA256 签名密钥（机密；原硬编码值已泄露并轮换，
# 需与上游数据供给方 192.168.0.127:18084 同步为新值）
EBMS_APP_SECRET=

# 本系统对外接口 /api/external 的入站 API Key（X-API-Key，机密）
EBMS_EXTERNAL_API_KEY=

# ===== AEOS 销售数据同步通道（EBMS ↔ CRM/M05，契约见 contracts/aeos-contracts-v1.schema.json）=====
# 四个变量均为按需启用：未配置时通道 fail-closed —— 入站端点返回 503 且不写业务表，
# 出站事件一律留在本地 Outbox（不丢事件），不产生任何对外投递。

# 入站：CRM 回写事件推送到 EBMS /api/aeos/ingest 时必须携带的 Bearer 令牌（机密）。
# 这是 EBMS 自己签发的令牌（开发B 侧持有），与下面 CRM 侧的令牌不是同一个值。
EBMS_INGEST_TOKEN=

# 出站：向 CRM /api/v1/integrations/ebms/ingest 投递时携带的 Bearer 令牌（机密）。
# 与 CRM 侧同名同值 —— 契约 §5.2 冻结 CRM 入站校验的就是 EBMS_INBOUND_TOKEN，
# EBMS 出站携带同一个值；两端部署时填入同一串随机值。
EBMS_INBOUND_TOKEN=

# 出站：CRM 入站端点地址。留空则出站不投递，事件只堆在 Outbox 等人工处理。
EBMS_CRM_INGEST_URL=

# 出站：本地 spool 目录（transport=spool 时用于落盘投递）。留空则用 backend/data/aeos-outbox-spool。
EBMS_AEOS_SPOOL_DIR=
